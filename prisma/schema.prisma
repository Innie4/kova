generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum PreferredMethod {
  WALLET
  BANK
  MOBILE_MONEY
  CASH
}

enum TransferStatus {
  DRAFT
  PREVIEWED
  AWAITING_CONFIRMATION
  EXECUTING
  COMPLETED
  FAILED
}

enum RailName {
  WISE
  KOTANI
  KITE_NATIVE
  MOCK
}

enum AgentLogStep {
  INTENT_PARSED
  RAIL_QUERY_STARTED
  RAIL_QUERY_COMPLETED
  ROUTE_SCORED
  CONFIRMATION_REQUIRED
  TRANSFER_EXECUTED
  ATTESTATION_WRITTEN
  NOTIFICATION_SENT
  ERROR
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationPreference {
  SMS
  WHATSAPP
  BOTH
  NONE
}

enum KycDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
}

enum KycDocumentStatus {
  UPLOADED
  VERIFIED
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  fullName               String?                @map("full_name")
  phone                  String?
  country                String?
  kitePassportAddress    String?                @map("kite_passport_address")
  kitePassportHash       String?                @map("kite_passport_hash")
  kycStatus              KycStatus              @default(PENDING) @map("kyc_status")
  notificationPreference NotificationPreference @default(SMS) @map("notification_preference")
  demoModeEnabled        Boolean                @default(false) @map("demo_mode_enabled")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  wallet                 Wallet?
  recipients             Recipient[]
  sentTransfers          Transfer[]             @relation("TransferSender")
  kycDocuments           KycDocument[]

  @@map("users")
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  kiteAddress     String   @unique @map("kite_address")
  depositAddress  String?  @map("deposit_address")
  usdcBalance     Decimal  @default(0) @db.Decimal(18, 6) @map("usdc_balance")
  reputationScore Int      @default(0) @map("reputation_score")
  totalSavingsUsd Decimal  @default(0) @db.Decimal(18, 6) @map("total_savings_usd")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

model Recipient {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  name              String
  country           String
  phone             String
  preferredMethod   PreferredMethod @map("preferred_method")
  bankName          String?         @map("bank_name")
  bankAccountHint   String?         @map("bank_account_hint")
  mobileNetwork     String?         @map("mobile_network")
  isFavorite        Boolean         @default(false) @map("is_favorite")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivedTransfers Transfer[]      @relation("TransferRecipient")

  @@index([userId])
  @@map("recipients")
}

model Transfer {
  id                 String             @id @default(cuid())
  senderId           String             @map("sender_id")
  recipientId        String             @map("recipient_id")
  amountUsd          Decimal            @db.Decimal(18, 6) @map("amount_usd")
  feeUsd             Decimal            @default(0) @db.Decimal(18, 6) @map("fee_usd")
  savingsUsd         Decimal            @default(0) @db.Decimal(18, 6) @map("savings_usd")
  netDeliveryUsd     Decimal            @default(0) @db.Decimal(18, 6) @map("net_delivery_usd")
  routeSelected      RailName?          @map("route_selected")
  routeReason        String?            @map("route_reason")
  status             TransferStatus     @default(DRAFT)
  requiresConfirmation Boolean          @default(false) @map("requires_confirmation")
  intentRaw          String             @map("intent_raw")
  kiteAttestationHash String?           @map("kite_attestation_hash")
  kiteAttestationUrl String?            @map("kite_attestation_url")
  kiteTxHash         String?            @map("kite_tx_hash")
  notificationStatus NotificationStatus @default(PENDING) @map("notification_status")
  railsQueried       Json?              @map("rails_queried")
  createdAt          DateTime           @default(now()) @map("created_at")
  completedAt        DateTime?          @map("completed_at")
  sender             User               @relation("TransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient          Recipient          @relation("TransferRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  railQueries        RailQuery[]
  agentLogs          AgentLog[]

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@map("transfers")
}

model RailQuery {
  id          String    @id @default(cuid())
  transferId  String    @map("transfer_id")
  railName    RailName  @map("rail_name")
  feeUsd      Decimal   @db.Decimal(18, 6) @map("fee_usd")
  etaMinutes  Int       @map("eta_minutes")
  rate        Decimal   @db.Decimal(18, 6)
  available   Boolean   @default(true)
  reason      String?
  queryTimeMs Int?      @map("query_time_ms")
  queriedAt   DateTime  @default(now()) @map("queried_at")
  transfer    Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("rail_queries")
}

model AgentLog {
  id         String       @id @default(cuid())
  transferId String?      @map("transfer_id")
  step       AgentLogStep
  detail     Json
  createdAt  DateTime     @default(now()) @map("created_at")
  transfer   Transfer?    @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("agent_logs")
}

model KycDocument {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  documentType    KycDocumentType   @map("document_type")
  frontPath       String            @map("front_path")
  backPath        String?           @map("back_path")
  metadataHash    String            @map("metadata_hash")
  attestationHash String?           @map("attestation_hash")
  status          KycDocumentStatus @default(UPLOADED)
  createdAt       DateTime          @default(now()) @map("created_at")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_documents")
}
